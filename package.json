{
  "name": "n8n-nodes-delight",
  "version": "1.0.6",
  "description": "delight business software products are powerfull and very flexible all in one business solutions.",
  "homepage": "https://www.delight.ch/",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "delight",
    "email": "info@delight.ch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delight-software/n8n-nodes-delight.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DelightApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Delight/Delight.node.js",
      "dist/nodes/Delight/DelightPollingTrigger.node.js",
      "dist/nodes/Delight/DelightWebhookTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.53.3",
    "@types/node": "^26.6.5",
    "eslint": "9.29.0",
    "prettier": "3.9.10",
    "release-it": "^21.1.1",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
