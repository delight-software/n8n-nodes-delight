{
  "name": "n8n-nodes-delight",
  "version": "1.0.0",
  "description": "delight business software products are powerfull and very flexible all in one business solutions.",
  "homepage": "https://www.delight.ch/",
  "license": "MIT",
  "private": true,
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "delight",
    "email": "info@delight.ch"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DelightApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Delight/Delight.node.js",
      "dist/nodes/Delight/DelightPollingTrigger.node.js",
      "dist/nodes/Delight/DelightWebhookTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^26.2.0",
    "eslint": "9.29.0",
    "prettier": "3.9.6",
    "release-it": "^21.0.2",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}